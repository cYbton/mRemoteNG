<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework><!-- sysprep fork: no Windows 10 SDK target, it shipped the 56 MB WinRT projection (Microsoft.Windows.SDK.NET.dll) that nothing uses -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>True</UseWindowsForms>
    <Platforms>x64;arm64</Platforms>
    <Configurations>Debug;Release;Release Self-Contained;Deploy to github</Configurations>
    <AssemblyName>mRp.Contracts</AssemblyName>
    <RootNamespace>mRemoteNG.PluginContracts</RootNamespace>
  </PropertyGroup>
</Project>
